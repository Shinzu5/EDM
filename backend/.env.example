# --- Database (Neon) --------------------------------------------------------
# Use the POOLED connection string for the app (IPv6/dual-stack pooler, port 5432).
# Neon free tier has NO BAA — this project uses SYNTHETIC data only.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.aws.neon.tech:5432/neondb?sslmode=require"
# Use the UNPOOLED (direct) string for migrations (prisma migrate deploy).
DIRECT_URL="postgresql://user:password@ep-xxxx.aws.neon.tech:5432/neondb?sslmode=require"

# --- Redis (Upstash) --------------------------------------------------------
# Use the rediss:// TLS URL in production; local dev can use infra/docker-compose redis.
REDIS_URL="rediss://default:password@upstash.io:6379"

# --- Auth -------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"

# --- Object storage (S3-compatible, e.g. AWS / Cloudflare R2) ---------------
S3_BUCKET="medidata-documents"
S3_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="change-me"
AWS_SECRET_ACCESS_KEY="change-me"

# --- Ports ------------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
